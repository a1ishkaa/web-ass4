
body {
    background: #f4f6f9;
    font-family: Arial, sans-serif;
}

h1 {
    color: #0d6efd;
}

section {
    background: white;
    padding: 20px;
    margin: 20px 0;
    border: 1px solid #ddd;
    border-radius: 6px;
}

h2 {
    font-size: 21px;
    margin-bottom: 18px;
}

@media (max-width: 576px) {
    section {
        padding: 12px;
    }
}